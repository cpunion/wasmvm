diff --git a/internal/build/dispatch_inline.go b/internal/build/dispatch_inline.go
new file mode 100644
index 000000000..3778fff2d
--- /dev/null
+++ b/internal/build/dispatch_inline.go
@@ -0,0 +1,148 @@
+package build
+
+import (
+	"strings"
+
+	"github.com/xgo-dev/llgo/internal/lto"
+	"github.com/xgo-dev/llgo/internal/optlevel"
+	"github.com/xgo-dev/llvm"
+)
+
+// Use LLVM 22's ordinary O3 cost budget in unprofiled switch cycles, where
+// dividing probability across cases can otherwise suppress useful inlining.
+// LLVM still checks cost and viability; no profile weights are manufactured.
+func applyDispatchInlineBudget(conf *Config, mod llvm.Module) int {
+	if !dispatchInlineEnabled(conf) {
+		return 0
+	}
+	for _, row := range mod.NamedMetadataOperands("llvm.module.flags") {
+		for _, field := range row.MDNodeOperands() {
+			if field.IsAMDString() && strings.Contains(field.MDString(), "ProfileSummary") {
+				return 0
+			}
+		}
+	}
+	ctx := mod.Context()
+	prof := ctx.MDKindID("prof")
+	hint := ctx.CreateStringAttribute("function-inline-threshold", "250")
+	count := 0
+	for fn := mod.FirstFunction(); !fn.IsNil(); fn = llvm.NextFunction(fn) {
+		if fn.IsDeclaration() || hasInlineBarrier(fn, false, "optnone", "optsize", "minsize", "cold") {
+			continue
+		}
+		profiled := false
+		for _, bb := range fn.BasicBlocks() {
+			for inst := bb.FirstInstruction(); !inst.IsNil(); inst = llvm.NextInstruction(inst) {
+				profiled = profiled || !inst.Metadata(prof).IsNil()
+			}
+		}
+		if profiled {
+			continue
+		}
+		for bb := range cyclicSwitchBlocks(fn.FirstBasicBlock()) {
+			for call := bb.FirstInstruction(); !call.IsNil(); call = llvm.NextInstruction(call) {
+				if call.InstructionOpcode() != llvm.Call && call.InstructionOpcode() != llvm.Invoke {
+					continue
+				}
+				callee := call.CalledValue().IsAFunction()
+				if callee.IsNil() || strings.HasPrefix(callee.Name(), "llvm.") ||
+					hasInlineBarrier(callee, false, "cold", "noinline", "alwaysinline", "noreturn") ||
+					hasInlineBarrier(call, true, "cold", "noinline", "alwaysinline", "noreturn") ||
+					!call.GetCallSiteStringAttribute(-1, "function-inline-threshold").IsNil() {
+					continue
+				}
+				if !callee.GetStringAttributeAtIndex(-1, "function-inline-threshold").IsNil() ||
+					!callee.GetStringAttributeAtIndex(-1, "function-inline-cost").IsNil() ||
+					!call.GetCallSiteStringAttribute(-1, "function-inline-cost").IsNil() {
+					continue
+				}
+				call.AddCallSiteAttribute(-1, hint)
+				count++
+			}
+		}
+	}
+	return count
+}
+
+func dispatchInlineEnabled(conf *Config) bool {
+	return conf != nil && conf.Goos == "linux" && conf.Goarch == "amd64" &&
+		conf.OptLevel == optlevel.O3 && conf.ltoMode() == lto.Full && conf.BuildMode == BuildModeExe
+}
+
+// Leave explicit backend policy and alternative linkers in control. The same
+// predicate gates both the bitcode hints and the LLVM complete-cost option.
+func (c *context) dispatchInlineBudgetEnabled() bool {
+	if !c.nativeFullLTOELFEnabled() {
+		return false
+	}
+	flags := c.nativeBackendFlags()
+	for _, flag := range flags {
+		if strings.Contains(flag, "inline") || strings.Contains(flag, "callsite") {
+			return false
+		}
+	}
+	return true
+}
+
+func hasInlineBarrier(value llvm.Value, call bool, names ...string) bool {
+	for _, name := range names {
+		kind := llvm.AttributeKindID(name)
+		attr := value.GetEnumAttributeAtIndex
+		if call {
+			attr = value.GetCallSiteEnumAttribute
+		}
+		if !attr(-1, kind).IsNil() {
+			return true
+		}
+	}
+	return false
+}
+
+// Tarjan's traversal includes irreducible cycles and excludes unreachable code.
+func cyclicSwitchBlocks(entry llvm.BasicBlock) map[llvm.BasicBlock]bool {
+	index := make(map[llvm.BasicBlock]int)
+	low := make(map[llvm.BasicBlock]int)
+	onStack := make(map[llvm.BasicBlock]bool)
+	result := make(map[llvm.BasicBlock]bool)
+	var stack []llvm.BasicBlock
+	var visit func(llvm.BasicBlock)
+	visit = func(bb llvm.BasicBlock) {
+		index[bb] = len(index) + 1
+		low[bb] = index[bb]
+		stack = append(stack, bb)
+		onStack[bb] = true
+		term := bb.LastInstruction()
+		self := false
+		for i := 0; i < term.SuccessorsCount(); i++ {
+			next := term.Successor(i)
+			self = self || next == bb
+			if index[next] == 0 {
+				visit(next)
+				low[bb] = min(low[bb], low[next])
+			} else if onStack[next] {
+				low[bb] = min(low[bb], index[next])
+			}
+		}
+		if low[bb] != index[bb] {
+			return
+		}
+		start := len(stack) - 1
+		for stack[start] != bb {
+			start--
+		}
+		members := stack[start:]
+		dispatch := false
+		for _, member := range members {
+			dispatch = dispatch || member.LastInstruction().InstructionOpcode() == llvm.Switch
+			onStack[member] = false
+		}
+		if dispatch && (self || len(members) > 1) {
+			for _, member := range members {
+				result[member] = true
+			}
+		}
+		stack = stack[:start]
+	}
+	visit(entry)
+	return result
+}
diff --git a/internal/build/dispatch_inline_test.go b/internal/build/dispatch_inline_test.go
new file mode 100644
index 000000000..12b96cf23
--- /dev/null
+++ b/internal/build/dispatch_inline_test.go
@@ -0,0 +1,160 @@
+package build
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/xgo-dev/llgo/internal/crosscompile"
+	"github.com/xgo-dev/llgo/internal/lto"
+	"github.com/xgo-dev/llgo/internal/optlevel"
+	"github.com/xgo-dev/llvm"
+)
+
+const dispatchInlineIR = `
+declare i32 @helper(ptr)
+declare i32 @blocked(ptr) noinline
+declare i32 @panic(ptr) cold noreturn
+declare i32 @custom_helper(ptr) "function-inline-threshold"="12"
+define void @dispatch(i32 %n, ptr %p, i1 %choose) {
+entry:
+  %outside = call i32 @helper(ptr %p)
+  br i1 %choose, label %switch, label %other
+switch:
+  %header = call i32 @helper(ptr %p)
+  switch i32 %n, label %exit [i32 0, label %work]
+work:
+  %body = call i32 @helper(ptr %p)
+  %barrier = call i32 @blocked(ptr %p)
+  %cold = call i32 @panic(ptr %p)
+  %custom = call i32 @helper(ptr %p) "function-inline-threshold"="12"
+  %explicit = call i32 @helper(ptr %p) noinline
+  %function_policy = call i32 @custom_helper(ptr %p)
+  %cost_policy = call i32 @helper(ptr %p) "function-inline-cost"="1000"
+  br label %switch
+other:
+  %unrelated = call i32 @helper(ptr %p)
+  br i1 %choose, label %other, label %tail
+tail:
+  switch i32 %n, label %exit [i32 0, label %once]
+once:
+  %acyclic = call i32 @helper(ptr %p)
+  ret void
+exit:
+  ret void
+unreachable:
+  %dead = call i32 @helper(ptr %p)
+  switch i32 %n, label %unreachable [i32 0, label %exit]
+}
+`
+
+func TestDispatchInlineBackendOverrides(t *testing.T) {
+	for _, name := range []string{"CCFLAGS", "CFLAGS", "LDFLAGS"} {
+		t.Setenv(name, "")
+	}
+	for _, test := range []struct {
+		name   string
+		change func(*context)
+	}{
+		{"default", nil},
+		{"external linker", func(c *context) { c.buildConf.LinkOptions.ExternalLinker = "clang" }},
+		{"direct linker", func(c *context) { c.crossCompile.Linker = "ld.lld" }},
+		{"driver linker override", func(c *context) { c.crossCompile.CXXArgs = []string{"-fuse-ld=gold"} }},
+		{"other backend", func(c *context) { c.crossCompile.Toolchain.Linker = "" }},
+		{"extldflags", func(c *context) { c.buildConf.LinkOptions.ExternalLinkerFlags = "-Wl,-mllvm,-inline-threshold=20" }},
+		{"driver args", func(c *context) { c.crossCompile.CXXArgs = []string{"-fno-inline"} }},
+		{"target flags", func(c *context) { c.crossCompile.LDFLAGS = []string{"-Wl,-mllvm,-cold-callsite-rel-freq=0"} }},
+		{"environment", func(c *context) { t.Setenv("LDFLAGS", "-Wl,-mllvm,-inline-cost-full=false") }},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			c := &context{buildConf: dispatchInlineConfig(), crossCompile: crosscompile.Export{
+				Toolchain: crosscompile.NativeToolchain{ObjectFormat: crosscompile.ObjectFormatELF, Linker: crosscompile.LinkerFlavorELFLLD},
+			}}
+			if test.change != nil {
+				test.change(c)
+			}
+			want := test.change == nil
+			if got := c.dispatchInlineBudgetEnabled(); got != want {
+				t.Fatalf("policy enabled = %v, want %v", got, want)
+			}
+			args := c.linker().LinkArguments()
+			found := false
+			for _, arg := range args {
+				found = found || arg == "-Wl,-mllvm,-inline-cost-full"
+			}
+			if found != want {
+				t.Fatalf("complete-cost default = %v, want %v: %v", found, want, args)
+			}
+		})
+	}
+}
+
+func dispatchInlineConfig() *Config {
+	return &Config{Goos: "linux", Goarch: "amd64", BuildMode: BuildModeExe, OptLevel: optlevel.O3, LTO: lto.Full}
+}
+
+func TestDispatchInlineBudget(t *testing.T) {
+	mod := parseWasmAggregateIR(t, dispatchInlineIR)
+	if got := applyDispatchInlineBudget(dispatchInlineConfig(), mod); got != 2 {
+		t.Fatalf("hinted %d calls, want 2", got)
+	}
+	for _, bb := range mod.NamedFunction("dispatch").BasicBlocks() {
+		for inst := bb.FirstInstruction(); !inst.IsNil(); inst = llvm.NextInstruction(inst) {
+			if inst.InstructionOpcode() != llvm.Call {
+				continue
+			}
+			got := inst.GetCallSiteStringAttribute(-1, "function-inline-threshold")
+			want := ""
+			switch inst.Name() {
+			case "header", "body":
+				want = "250"
+			case "custom":
+				want = "12"
+			}
+			if want == "" {
+				if !got.IsNil() {
+					t.Errorf("%s unexpectedly has a budget", inst.Name())
+				}
+			} else if got.IsNil() || got.GetStringValue() != want {
+				t.Errorf("%s budget = %v, want %s", inst.Name(), got, want)
+			}
+		}
+	}
+	if got := applyDispatchInlineBudget(dispatchInlineConfig(), mod); got != 0 {
+		t.Fatalf("second application hinted %d calls", got)
+	}
+	if err := llvm.VerifyModule(mod, llvm.ReturnStatusAction); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDispatchInlineBudgetScope(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		change func(*Config)
+	}{
+		{"O2", func(c *Config) { c.OptLevel = optlevel.O2 }},
+		{"Os", func(c *Config) { c.OptLevel = optlevel.Os }},
+		{"ThinLTO", func(c *Config) { c.LTO = lto.Thin }},
+		{"off", func(c *Config) { c.LTO = lto.Off }},
+		{"arm64", func(c *Config) { c.Goarch = "arm64" }},
+		{"darwin", func(c *Config) { c.Goos = "darwin" }},
+		{"library", func(c *Config) { c.BuildMode = BuildModeCArchive }},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			mod := parseWasmAggregateIR(t, dispatchInlineIR)
+			conf := dispatchInlineConfig()
+			test.change(conf)
+			if got := applyDispatchInlineBudget(conf, mod); got != 0 {
+				t.Fatalf("hinted %d calls outside the scope", got)
+			}
+		})
+	}
+}
+
+func TestDispatchInlineBudgetPreservesProfiles(t *testing.T) {
+	source := strings.Replace(dispatchInlineIR, "br label %switch", "br label %switch, !prof !0", 1) + "\n!0 = !{!\"branch_weights\", i32 10}\n"
+	mod := parseWasmAggregateIR(t, source)
+	if got := applyDispatchInlineBudget(dispatchInlineConfig(), mod); got != 0 {
+		t.Fatalf("hinted %d calls in a profiled function", got)
+	}
+}
diff --git a/internal/build/native_code_layout.go b/internal/build/native_code_layout.go
new file mode 100644
index 000000000..09365839f
--- /dev/null
+++ b/internal/build/native_code_layout.go
@@ -0,0 +1,69 @@
+package build
+
+import (
+	"os"
+	"strings"
+
+	"github.com/xgo-dev/llgo/internal/crosscompile"
+)
+
+func (c *context) nativeFullLTOELFEnabled() bool {
+	if c == nil || !dispatchInlineEnabled(c.buildConf) ||
+		c.crossCompile.Toolchain.ObjectFormat != crosscompile.ObjectFormatELF ||
+		c.crossCompile.Toolchain.Linker != crosscompile.LinkerFlavorELFLLD ||
+		c.crossCompile.Linker != "" || c.buildConf.LinkOptions.ExternalLinker != "" {
+		return false
+	}
+	for _, flag := range c.nativeBackendFlags() {
+		for _, arg := range strings.Fields(flag) {
+			if strings.HasPrefix(arg, "--ld-path=") ||
+				(strings.HasPrefix(arg, "-fuse-ld=") && arg != "-fuse-ld=lld") {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func (c *context) nativeBackendFlags() []string {
+	flags := []string{c.buildConf.LinkOptions.ExternalLinkerFlags}
+	for _, name := range []string{"CCFLAGS", "CFLAGS", "LDFLAGS"} {
+		flags = append(flags, os.Getenv(name), c.commands.lookup(name))
+	}
+	for _, args := range [][]string{c.crossCompile.CCArgs, c.crossCompile.CXXArgs,
+		c.crossCompile.LinkerArgs, c.crossCompile.CCFLAGS, c.crossCompile.CFLAGS, c.crossCompile.LDFLAGS} {
+		flags = append(flags, args...)
+	}
+	return flags
+}
+
+// Set final-backend defaults only for optimized native x86-64 ELF executables.
+// Aligning loops alone leaves dispatch performance sensitive to branch placement;
+// combine cache-line loop alignment with the x86 branch-boundary padding pass.
+func (c *context) nativeFullLTOLinkerArgs() []string {
+	if !c.nativeFullLTOELFEnabled() {
+		return nil
+	}
+	layout := true
+	for _, flag := range c.nativeBackendFlags() {
+		for _, option := range []string{"align-loops", "align-all", "x86-align-branch", "x86-branches-within"} {
+			if strings.Contains(flag, option) {
+				layout = false
+			}
+		}
+	}
+	var args []string
+	if layout {
+		args = append(args, "-Wl,-mllvm,-align-loops=64",
+			"-Wl,-mllvm,-x86-align-branch-boundary=32",
+			// Exclude calls and returns: their adjacent PC labels participate
+			// in runtime stack and source-position metadata.
+			"-Wl,-mllvm,-x86-align-branch=fused+jcc+jmp+indirect")
+	}
+	if c.dispatchInlineBudgetEnabled() {
+		// LLVM 22 reads function-inline-threshold only after completing its
+		// cost walk; otherwise a cold-site early exit masks the hint.
+		args = append(args, "-Wl,-mllvm,-inline-cost-full")
+	}
+	return args
+}
diff --git a/internal/build/native_code_layout_test.go b/internal/build/native_code_layout_test.go
