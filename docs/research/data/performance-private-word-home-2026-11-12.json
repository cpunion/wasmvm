  "measurementScript": "from pathlib import Path\nimport os,json,random,statistics,sys,time\nROOT=Path('/Users/lijie/source/goplus/wasmvm')\nWORK=Path('/Users/lijie/source/goplus/wasmvm-source-cleanup')\nOUT=Path(__file__).resolve().parent\nsys.path.insert(0,str(WORK/'benchmarks'))\nimport interleaved\nos.environ['GOMAXPROCS']='1'\nfor key in ('WASMVM_COMPILE_PHASE','WASMVM_WARM_PROFILE','WASMVM_WARM_ALLOC_PROFILE','WASMVM_DIAGNOSTIC_JIT_MAP'):os.environ.pop(key,None)\ncount=50000000;seed=17;expected=(count+seed)&0xffffffff\nvariants={'base':ROOT/'artifacts/protocol-cost-20261112/loop-memory-stores/base-go-phase','head':OUT.parent/'final-head-go-phase','wasmtime':ROOT/'artifacts/protocol-cost-20261112/loop-memory-stores/references/wasmtime-phase','wasmer':ROOT/'artifacts/protocol-cost-20261112/loop-memory-stores/references/wasmer-phase'}\ncommands={}\nfor name,binary in variants.items():\n cmd=[str(binary),'--backend','native'if name in ('base','head')else'compiler','--wasm',str(ROOT/'benchmarks/modern/threads-private-memory.wasm'),'--iterations',str(count),'--seed',str(seed),'--expected',str(expected),'--samples','7','--warmups','2']\n if name in ('base','head'):cmd+=['--mode','api']\n commands[name]=cmd;commands[name+'-aa']=cmd\nplan=dict(blocks=20,samples=7,warmups=2,iterations=count,seed=seed,expected=expected,randomSeed=2026112543,commands=commands,scope='Fixed20block/160freshprocess diagnostic; b01fc29 versus cache-home proof and shared dead-immediate plan. Original stores/polls retained; two serialcacheMOVs removed onlyforproven stablecanonicalprivatewordhome; checked original private-memory workload, normal publicAPI/native cancellation and limits retained. Interleave7warmcalls perprocess afterfirst+2warmups; allfirst/warmup/warm checksumsverified. Startup/compile/instantiate/cleanup separate. Same GOMAXPROCS1, pinnedGo1.27.3/Clang22.1.8 and Wasmtime48.0.1/Wasmer7.3.0. No owned builds/tests/profiles/pruning overlap. Reference interruption policies remain distinct. No fullportfolio orreleaseacceptance claim.')\nassert not(OUT/'rows.jsonl').exists()\n(OUT/'plan.json').write_text(json.dumps(plan,indent=2)+'\\n')\nrng=random.Random(plan['randomSeed']);rows=[]\nfor block in range(plan['blocks']):\n observations,orders=interleaved.invoke(commands,120,rng,samples=7)\n for name,ob in observations.items():\n  record=ob['record'];assert record['warmResults']==[expected]*7 and record['warmupResults']==[expected]*2 and record['result']==expected\n  assert record['iterations']==count and record['seed']==seed\n  row=dict(block=block,id=name,observation=ob,orders=orders,nsPerIteration=statistics.median(record['warmCallNs'])/count)\n  with(OUT/'rows.jsonl').open('a')as f:f.write(json.dumps(row)+'\\n')\n  rows.append(row)\n print(block,{name:round(statistics.median(r['nsPerIteration']for r in rows if r['block']==block and r['id']==name),5)for name in commands},flush=True)\nsummary={name:statistics.median(r['nsPerIteration']for r in rows if r['id']==name)for name in commands}\n(OUT/'summary.json').write_text(json.dumps(dict(plan=plan,summary=summary),indent=2)+'\\n');print(json.dumps(summary),flush=True)\n",
