      "source": "#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <time.h>\nstatic uint64_t now(void) { struct timespec t; if (clock_gettime(CLOCK_MONOTONIC_RAW, &t)) exit(2); return (uint64_t)t.tv_sec*1000000000+t.tv_nsec; }\n__attribute__((noinline)) static uint32_t run(uint32_t x, uint32_t n) {\n    __asm__ volatile(\"\" : \"+r\"(x), \"+r\"(n) : : \"memory\");\n    for (uint32_t i=0;i<n;++i) x=x*UINT32_C(1664525)+UINT32_C(1013904223);\n    return x;\n}\nint main(int argc, char **argv) {\n    if (argc != 4) return 2;\n    uint32_t count=(uint32_t)strtoul(argv[1],0,10), seed=(uint32_t)strtoul(argv[2],0,10), expected=(uint32_t)strtoul(argv[3],0,10);\n    if (!count || count>INT32_MAX) return 2;\n    char line[32]; uint64_t warm[7], first=0;\n    puts(\"{\\\"ready\\\":true}\"); fflush(stdout);\n    if (!fgets(line,sizeof line,stdin) || strcmp(line,\"run\\n\")) return 2;\n    for (int i=-3;i<7;++i) {\n        if (i>=0) { printf(\"{\\\"sampleReady\\\":%d}\\n\",i); fflush(stdout); if (!fgets(line,sizeof line,stdin) || strcmp(line,\"sample\\n\")) return 2; }\n        uint64_t start=now(); uint32_t result=run(seed,count); uint64_t elapsed=now()-start;\n        if (result != expected) return 3;\n        if (i==-3) first=elapsed;\n        if (i>=0) warm[i]=elapsed;\n    }\n    printf(\"{\\\"engine\\\":\\\"native-llvm-control\\\",\\\"iterations\\\":%u,\\\"seed\\\":%u,\\\"result\\\":%u,\\\"warmCallNs\\\":[\",count,seed,expected);\n    for(int i=0;i<7;++i) printf(\"%s%llu\",i?\",\":\"\",(unsigned long long)warm[i]);\n    printf(\"],\\\"warmResults\\\":[\"); for(int i=0;i<7;++i)printf(\"%s%u\",i?\",\":\"\",expected);\n    printf(\"],\\\"warmupResults\\\":[%u,%u],\\\"phasesNs\\\":{\\\"firstCall\\\":%llu}}\\n\",expected,expected,(unsigned long long)first);\n    return 0;\n}\n",
