(module
  (import "host" "collect" (func $collect))
  (import "host" "echo" (func $echo (param externref) (result externref)))
  (type $start-f (func (param externref) (result externref)))
  (type $start-c (cont $start-f))
  (type $empty-f (func (result externref)))
  (type $empty-c (cont $empty-f))
  (type $spin-f (func))
  (type $spin-c (cont $spin-f))
  (tag $yield (export "yield") (param externref) (result externref))
  (elem declare func $body $bound $echo $spin)
  (func $helper (param externref) (result externref)
    call $collect
    (suspend $yield (local.get 0))
    drop
    call $collect
    local.get 0)
  (func $body (type $start-f)
    (call $helper (local.get 0)))
  (func $bound (type $start-f)
    call $collect
    local.get 0)
  (func $spin (loop br 0))
  (func (export "capture") (param externref) (result externref (ref $start-c))
    (block $handler (result externref (ref $start-c))
      (resume $start-c (on $yield $handler)
        (local.get 0) (cont.new $start-c (ref.func $body)))
      unreachable))
  (func $finish (export "finish") (param (ref $start-c) externref) (result externref)
    (resume $start-c (local.get 1) (local.get 0)))
  (func (export "finish-deep") (param (ref $start-c) externref) (result externref)
    (call $finish (local.get 0) (local.get 1)))
  (func (export "null-inject") (param (ref $start-c)) (result externref)
    (resume_throw_ref $start-c (ref.null exn) (local.get 0)))
  (func (export "new-bound") (param externref) (result (ref $empty-c))
    (cont.bind $start-c $empty-c (local.get 0) (cont.new $start-c (ref.func $bound))))
  (func (export "new-host-bound") (param externref) (result (ref $empty-c))
    (cont.bind $start-c $empty-c (local.get 0) (cont.new $start-c (ref.func $echo))))
  (func (export "finish-bound") (param (ref $empty-c)) (result externref)
    (resume $empty-c (local.get 0)))
  (func (export "unhandled") (param externref) (result externref)
    (suspend $yield (local.get 0)))
  (func (export "spin")
    (resume $spin-c (cont.new $spin-c (ref.func $spin))))
)
