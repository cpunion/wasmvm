(module
  (import "host" "collect" (func $collect))
  (rec
    (type $object (descriptor $descriptor) (struct (field (ref null $object))))
    (type $descriptor (describes $object)
      (struct (field externref) (field (mut (ref null $object)))))
  )
  (tag $tag (param (ref $object)))
  (func (export "new") (param externref) (result (ref $object))
    (local $desc (ref null (exact $descriptor)))
    (local $value (ref null (exact $object)))
    (local.set $desc (struct.new $descriptor (local.get 0) (ref.null $object)))
    (local.set $value (struct.new_desc $object (ref.null $object) (local.get $desc)))
    (struct.set $descriptor 1 (local.get $desc) (local.get $value))
    (ref.as_non_null (local.get $value)))
  (func (export "payload") (param (ref $object)) (result externref)
    (struct.get $descriptor 0 (ref.get_desc $object (local.get 0))))
  (func (export "check") (param (ref $object)) (result i32)
    (ref.eq (local.get 0)
      (ref.cast_desc_eq (ref $object)
        (local.get 0) (ref.get_desc $object (local.get 0)))))
  (func (export "echo-exception") (param (ref $object)) (result (ref $object))
    (block (result (ref $object))
      (try_table (catch $tag 0)
        (throw $tag (local.get 0)))
      unreachable)
    (call $collect))
)
