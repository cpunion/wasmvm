(module
 (import "env" "memory" (memory $shared 1 3 shared))
 (memory $private 1)
 (export "memory" (memory $shared))
 (data (memory $shared) (i32.const 32) "S")
 (func (export "load") (param i32) (result i32) (i32.load $shared (local.get 0)))
 (func (export "store") (param i32 i32) (i32.store $shared (local.get 0) (local.get 1)))
 (func (export "add") (param i32 i32) (result i32) (i32.atomic.rmw.add $shared (local.get 0) (local.get 1)))
 (func (export "wait32") (param i32 i32 i64) (result i32) (memory.atomic.wait32 $shared (local.get 0) (local.get 1) (local.get 2)))
 (func (export "wait64") (param i32 i64 i64) (result i32) (memory.atomic.wait64 $shared (local.get 0) (local.get 1) (local.get 2)))
 (func (export "notify") (param i32 i32) (result i32) (memory.atomic.notify $shared (local.get 0) (local.get 1)))
 (func (export "size") (result i32) (memory.size $shared))
 (func (export "grow") (param i32) (result i32) (memory.grow $shared (local.get 0)))
 (func (export "fill") (param i32 i32 i32) (memory.fill $shared (local.get 0) (local.get 1) (local.get 2)))
 (func (export "mixed") (param i32) (result v128)
  (v128.store $private (i32.const 0) (v128.const i64x2 11 22))
  (memory.copy $shared $private (local.get 0) (i32.const 0) (i32.const 16))
  (memory.copy $private $shared (i32.const 16) (local.get 0) (i32.const 16))
  (v128.load $private (i32.const 16)))
 (func (export "vector") (param i32) (result v128)
  (v128.load $shared (local.get 0)))
 (func (export "fence") atomic.fence)
)
