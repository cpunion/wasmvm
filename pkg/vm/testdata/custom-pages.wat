(module
  (import "h" "small" (memory $small 8 131072 (pagesize 1)))
  (import "h" "wide" (memory $wide i64 8 131072 (pagesize 1)))
  (import "h" "shared" (memory $shared 8 131072 shared (pagesize 1)))
  (memory $default 1)
  (func (export "small-size") (result i32) memory.size $small)
  (func (export "wide-size") (result i64) memory.size $wide)
  (func (export "shared-size") (result i32) memory.size $shared)
  (func (export "default-size") (result i32) memory.size $default)
  (func (export "small-grow") (param i32) (result i32) (memory.grow $small (local.get 0)))
  (func (export "wide-grow") (param i64) (result i64) (memory.grow $wide (local.get 0)))
  (func (export "shared-grow") (param i32) (result i32) (memory.grow $shared (local.get 0)))
  (func (export "small-load") (param i32) (result i32) (i32.load8_u $small (local.get 0)))
  (func (export "wide-load") (param i64) (result i32) (i32.load8_u $wide (local.get 0)))
  (func (export "shared-add") (param i32) (result i32)
    (i32.atomic.rmw.add $shared (local.get 0) (i32.const 1)))
  (func (export "small-constant-oob") (result i32) (i32.load $small (i32.const 8)))
  (func (export "shared-wait") (param i32) (result i32)
    (memory.atomic.wait32 $shared (local.get 0) (i32.const 0) (i64.const 0)))
)
