(module
 (rec (type $node (struct
  (field (mut (ref null $node))) (field (mut i32)) (field funcref) (field externref))))
 (type $base (sub (struct (field (mut i32)))))
 (type $child (sub $base (struct (field (mut i32)) (field i64))))
 (type $array (array (mut (ref null $node))))
 (type $bytes (array (mut i8)))
 (type $vectors (array (mut v128)))
 (type $open (sub (func (param i32) (result i32))))
 (type $more (sub $open (func (param i32) (result i32))))
 (func $answer (result i32) (i32.const 42))
 (func $plus (export "plus") (type $more) (i32.add (local.get 0) (i32.const 1)))
 (elem declare func $answer $plus)
 (global $constant (ref $node)
  (struct.new $node (ref.null $node) (i32.const 99) (ref.func $answer) (ref.null extern)))
 (global $root (mut (ref null $node)) (ref.null $node))
 (table (export "table") 1 (ref null $node))
 (func (export "new") (param i32 externref) (result (ref $node))
  (struct.new $node (ref.null $node) (local.get 0) (ref.func $answer) (local.get 1)))
 (func (export "value") (param (ref null $node)) (result i32) (struct.get $node 1 (local.get 0)))
 (func (export "next") (param (ref $node)) (result (ref null $node)) (struct.get $node 0 (local.get 0)))
 (func (export "set-next") (param (ref $node) (ref null $node)) (struct.set $node 0 (local.get 0) (local.get 1)))
 (func (export "function") (param (ref $node)) (result funcref) (struct.get $node 2 (local.get 0)))
 (func (export "payload") (param (ref $node)) (result externref) (struct.get $node 3 (local.get 0)))
 (func (export "constant") (result (ref $node)) (global.get $constant))
 (func (export "save") (param (ref null $node)) (global.set $root (local.get 0)))
 (func (export "load") (result (ref null $node)) (global.get $root))
 (func (export "externalize") (param (ref null $node)) (result externref) (extern.convert_any (local.get 0)))
 (func (export "internalize") (param externref) (result (ref $node))
  (ref.cast (ref $node) (any.convert_extern (local.get 0))))
 (func (export "new-array") (param i32 (ref null $node)) (result (ref $array))
  (array.new $array (local.get 1) (local.get 0)))
 (func (export "get-array") (param (ref $array) i32) (result (ref null $node)) (array.get $array (local.get 0) (local.get 1)))
 (func (export "subtype") (result (ref $base)) (struct.new $child (i32.const 42) (i64.const 7)))
 (func (export "base-value") (param (ref $base)) (result i32) (struct.get $base 0 (local.get 0)))
 (func (export "host") (param (ref $open) i32) (result i32) (call_ref $open (local.get 1) (local.get 0)))
 (func (export "stress") (param $n i32) (result i32) (local $last (ref null $node))
  (loop $again
   (local.set $last (struct.new $node (ref.null $node) (local.get $n) (ref.func $answer) (ref.null extern)))
   (local.set $n (i32.sub (local.get $n) (i32.const 1)))
   (br_if $again (local.get $n)))
  (struct.get $node 1 (local.get $last)))
 (func (export "large") (param i32) (result (ref $bytes)) (array.new_default $bytes (local.get 0)))
 (func (export "bulk") (param (ref $bytes) i32 i32) (array.fill $bytes (local.get 0) (i32.const 0) (local.get 1) (local.get 2)))
 (func (export "vector") (result i64)
  (i64x2.extract_lane 1 (array.get $vectors (array.new $vectors (v128.const i64x2 7 11) (i32.const 1)) (i32.const 0))))
 (func (export "spin") (loop (drop (array.new_default $bytes (i32.const 4))) (br 0)))
 (func (export "nested") (result (ref $node))
  (struct.new $node
   (struct.new $node (ref.null $node) (i32.const 88) (ref.func $answer) (ref.null extern))
   (i32.const 99) (ref.func $answer) (ref.null extern)))

)
