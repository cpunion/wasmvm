(module
 (import "h" "tag" (tag $e (param i32 externref)))
 (import "h" "host" (func $host (param i32 externref)))
 (export "tag" (tag $e))
 (tag $other (export "other") (param i32 externref))
 (func $throw (export "throw") (param i32 externref)
  (throw $e (local.get 0) (local.get 1)))
 (func (export "catch") (param i32 externref) (result i32 externref)
  (block $c (result i32 externref)
   (try_table (catch $e $c) (call $throw (local.get 0) (local.get 1)))
   unreachable))
 (func (export "catch-host") (param i32 externref) (result i32 externref)
  (block $c (result i32 externref)
   (try_table (catch $e $c) (call $host (local.get 0) (local.get 1)))
   unreachable))
 (func (export "capture") (param i32 externref) (result (ref exn))
  (block $c (result (ref exn))
   (try_table (catch_all_ref $c) (call $throw (local.get 0) (local.get 1)))
   unreachable))
 (func $rethrow (export "rethrow") (param exnref) (throw_ref (local.get 0)))
 (func (export "catch-rethrow") (param exnref) (result i32 externref)
  (block $c (result i32 externref)
   (try_table (catch $e $c) (call $rethrow (local.get 0)))
   unreachable))
 (func $depth (param i32 externref)
  (if (local.get 0)
   (then (call $depth (i32.sub (local.get 0) (i32.const 1)) (local.get 1)))
   (else (throw $e (i32.const 42) (local.get 1)))))
 (func (export "depth") (param i32 externref) (result i32 externref)
  (block $c (result i32 externref)
   (try_table (catch $e $c) (call $depth (local.get 0) (local.get 1)))
   unreachable))
 (func (export "tail") (param i32 externref)
  (block $c (result i32 externref)
   (try_table (catch $e $c) (return_call $host (local.get 0) (local.get 1)))
   unreachable)
  drop drop)
 (func (export "trap") (try_table (catch_all 0) unreachable))
 (func (export "spin") (loop $loop (try_table (catch_all 0) (br $loop))))
)
