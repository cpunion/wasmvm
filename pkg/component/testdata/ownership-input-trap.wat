(component
  (import "r" (type $r (sub resource)))
  (type $get-type (func (param "value" (borrow $r)) (result u32)))
  (import "get" (func $get (type $get-type)))
  (type $consume-type (func (param "value" (own $r)) (result u32)))
  (import "consume" (func $consume (type $consume-type)))
  (type $create-type (func (result (own $r))))
  (import "create" (func $create (type $create-type)))
  (core func $get (canon lower (func $get)))
  (core func $consume (canon lower (func $consume)))
  (core func $create (canon lower (func $create)))
  (core func $drop (canon resource.drop $r))
  (core module $guest
    (import "env" "get" (func $get (param i32) (result i32)))
    (import "env" "consume" (func $consume (param i32) (result i32)))
    (import "env" "create" (func $create (result i32)))
    (import "env" "drop" (func $drop (param i32)))
    (func (export "get") (param i32) (result i32)
      (local $rep i32) local.get 0 call $get local.set $rep
      local.get 0 call $drop local.get $rep)
    (func (export "consume") (param i32) (result i32) unreachable)
    (func (export "create") (result i32) call $create))
  (core instance $env (export "get" (func $get)) (export "consume" (func $consume)) (export "create" (func $create)) (export "drop" (func $drop)))
  (core instance $guest (instantiate $guest (with "env" (instance $env))))
  (alias core export $guest "get" (core func $guest-get))
  (alias core export $guest "consume" (core func $guest-consume))
  (alias core export $guest "create" (core func $guest-create))
  (func (export "get") (type $get-type) (canon lift (core func $guest-get)))
  (func (export "consume") (type $consume-type) (canon lift (core func $guest-consume)))
  (func (export "create") (type $create-type) (canon lift (core func $guest-create))))
