(component
 (import "r" (type $r (sub resource)))
 (import "host" (func $host async (result u32)))
 (import "hook" (func $hook))
 (core func $host (canon lower (func $host)))
 (core func $hook (canon lower (func $hook)))
 (core func $drop (canon resource.drop $r))
 (core func $return (canon task.return))
 (core module $guest
  (import "env" "host" (func $host (result i32)))
  (import "env" "hook" (func $hook))
  (import "env" "drop" (func $drop (param i32)))
  (import "env" "return" (func $return))
  (global $posts (mut i32) (i32.const 0))
  (func (export "post") global.get $posts i32.const 1 i32.add global.set $posts)
  (func (export "counter") (result i32) global.get $posts)
  (func (export "escaped-direct") (param i32))
  (func (export "host") (result i32) call $host)
  (func (export "borrow") (param i32) local.get 0 call $drop call $return)
  (func (export "borrow-after") (param i32) local.get 0 call $drop call $return call $hook)
  (func (export "escaped") (param i32) call $return local.get 0 call $drop)
  (func (export "pass") (param i32) (result i32) local.get 0)
  (func (export "after") call $return call $hook))
 (core instance $env (export "host" (func $host)) (export "hook" (func $hook)) (export "drop" (func $drop)) (export "return" (func $return)))
 (core instance $guest (instantiate $guest (with "env" (instance $env))))
 (alias core export $guest "post" (core func $post))
 (func (export "host") async (result u32) (canon lift (core func $guest "host")))
 (func (export "borrow") async (param "value" (borrow $r)) (canon lift (core func $guest "borrow") async))
 (func (export "borrow-after") async (param "value" (borrow $r)) (canon lift (core func $guest "borrow-after") async))
 (func (export "escaped") async (param "value" (borrow $r)) (canon lift (core func $guest "escaped") async))
 (func (export "escaped-direct") async (param "value" (borrow $r)) (canon lift (core func $guest "escaped-direct") (post-return $post)))
 (func (export "pass") (param "value" (own $r)) (result (own $r)) (canon lift (core func $guest "pass")))
 (func (export "after") async (canon lift (core func $guest "after") async)))
