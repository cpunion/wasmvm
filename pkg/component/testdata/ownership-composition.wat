(component
 (component $library 
  (core module $state
    (global $total (mut i32) (i32.const 0))
    (func (export "dtor") (param i32)
      global.get $total local.get 0 i32.add global.set $total)
    (func (export "total") (result i32) global.get $total))
  (core instance $state (instantiate $state))
  (alias core export $state "dtor" (core func $dtor))
  (alias core export $state "total" (core func $total))
  (type $r (resource (rep i32) (dtor (func $dtor))))
  (export "r" (type $r))
  (core func $new (canon resource.new $r))
  (core func $rep (canon resource.rep $r))
  (core func $drop (canon resource.drop $r))
  (core module $guest
    (import "env" "new" (func $new (param i32) (result i32)))
    (import "env" "rep" (func $rep (param i32) (result i32)))
    (import "env" "drop" (func $drop (param i32)))
    (func (export "make") (param i32) (result i32) local.get 0 call $new)
    (func (export "get") (param i32) (result i32) local.get 0)
    (func (export "pass") (param i32) (result i32) local.get 0)
    (func (export "consume") (param i32) (result i32)
      (local $rep i32) local.get 0 call $rep local.set $rep
      local.get 0 call $drop local.get $rep))
  (core instance $env (export "new" (func $new)) (export "rep" (func $rep)) (export "drop" (func $drop)))
  (core instance $guest (instantiate $guest (with "env" (instance $env))))
  (alias core export $guest "make" (core func $make))
  (alias core export $guest "get" (core func $get))
  (alias core export $guest "pass" (core func $pass))
  (alias core export $guest "consume" (core func $consume))
  (func (export "make") (param "rep" u32) (result (own 1)) (canon lift (core func $make)))
  (func (export "get") (param "self" (borrow 1)) (result u32) (canon lift (core func $get)))
  (func (export "pass") (param "value" (own 1)) (result (own 1)) (canon lift (core func $pass)))
  (func (export "consume") (param "value" (own 1)) (result u32) (canon lift (core func $consume)))
  (func (export "total") (result u32) (canon lift (core func $total))))
 (instance $library (instantiate $library))
 (alias export $library "r" (type $r))
 (export "r" (type $r))
 (alias export $library "make" (func $make))
 (alias export $library "get" (func $get))
 (alias export $library "total" (func $total))
 (core func $make (canon lower (func $make)))
 (core func $get (canon lower (func $get)))
 (core func $drop (canon resource.drop $r))
 (core module $wrapper
  (import "env" "make" (func $make (param i32) (result i32)))
  (import "env" "get" (func $get (param i32) (result i32)))
  (import "env" "drop" (func $drop (param i32)))
  (func (export "make") (param i32) (result i32) local.get 0 call $make)
  (func (export "get") (param i32) (result i32)
   (local $rep i32) local.get 0 call $get local.set $rep
   local.get 0 call $drop local.get $rep)
  (func (export "post") (param i32) unreachable))
 (core instance $env (export "make" (func $make)) (export "get" (func $get)) (export "drop" (func $drop)))
 (core instance $wrapper (instantiate $wrapper (with "env" (instance $env))))
 (alias core export $wrapper "make" (core func $wrapped-make))
 (alias core export $wrapper "get" (core func $wrapped-get))
 (alias core export $wrapper "post" (core func $post))
 (func (export "make") (param "rep" u32) (result (own 1)) (canon lift (core func $wrapped-make) (post-return $post)))
 (func (export "get") (param "self" (borrow 1)) (result u32) (canon lift (core func $wrapped-get)))
 (export "total" (func $total))
 (export "library" (instance $library)))
