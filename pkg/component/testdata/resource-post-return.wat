(component
  (type $r (resource (rep i32)))
  (core func $new (canon resource.new $r))
  (core func $rep (canon resource.rep $r))
  (core func $drop (canon resource.drop $r))
  (core module $post
    (import "env" "new" (func $new (param i32) (result i32)))
    (import "env" "rep" (func $rep (param i32) (result i32)))
    (import "env" "drop" (func $drop (param i32)))
    (func (export "check") (param i32) local.get 0 call $rep drop)
    (func (export "new") (param i32) local.get 0 call $new drop)
    (func (export "drop") (param i32) local.get 0 call $drop))
  (core instance $env (export "new" (func $new)) (export "rep" (func $rep)) (export "drop" (func $drop)))
  (core instance $post (instantiate $post (with "env" (instance $env))))
  (alias core export $post "check" (core func $check))
  (alias core export $post "new" (core func $post-new))
  (alias core export $post "drop" (core func $post-drop))
  (func (export "allow") (param "rep" u32) (result u32) (canon lift (core func $new) (post-return $check)))
  (func (export "reject-new") (param "rep" u32) (result u32) (canon lift (core func $new) (post-return $post-new)))
  (func (export "reject-drop") (param "rep" u32) (result u32) (canon lift (core func $new) (post-return $post-drop))))
