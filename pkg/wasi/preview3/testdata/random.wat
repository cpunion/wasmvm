  (type (func (param "len" u64) (result 0)))
  (export "get-random-bytes" (func (type 1)))
  (type (func (result u64)))
  (export "get-random-u64" (func (type 2)))))
 (import "wasi:random/random@0.3.2" (instance $secure (type $secure-type)))
