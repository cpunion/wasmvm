  (import "env" "seed" (func $seed (param i32)))
  (func (export "secure-bytes") (param i64) (result i32) local.get 0 i32.const 0 call $secure-bytes i32.const 0)
  (func (export "insecure-bytes") (param i64) (result i32) local.get 0 i32.const 0 call $insecure-bytes i32.const 0)
  (func (export "secure-count") (param i64) (result i32) local.get 0 i32.const 0 call $secure-bytes i32.const 4 i32.load)
  (func (export "insecure-count") (param i64) (result i32) local.get 0 i32.const 0 call $insecure-bytes i32.const 4 i32.load)
  (func (export "secure-u64") (result i64) call $secure-u64)
  (func (export "insecure-u64") (result i64) call $insecure-u64)
  (func (export "seed") (result i32) i32.const 16 call $seed i32.const 16))
 (core instance $env (export "memory" (memory $memory-export))
  (export "secure-bytes" (func $secure-bytes)) (export "insecure-bytes" (func $insecure-bytes))
  (export "secure-u64" (func $secure-u64)) (export "insecure-u64" (func $insecure-u64))
  (export "seed" (func $seed)))
 (core instance $guest (instantiate $guest (with "env" (instance $env))))
 (type $bytes (list u8))
 (type $pair (tuple u64 u64))
 (alias core export $guest "secure-bytes" (core func $guest-secure-bytes))
 (func (export "secure-bytes") (param "len" u64) (result $bytes) (canon lift (core func $guest-secure-bytes) (memory $memory-export) (realloc $realloc) (post-return $reset)))
