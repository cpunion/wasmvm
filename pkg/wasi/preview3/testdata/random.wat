 (func (export "insecure-bytes") (param "len" u64) (result $bytes) (canon lift (core func $guest-insecure-bytes) (memory $memory-export) (realloc $realloc) (post-return $reset)))
 (alias core export $guest "secure-count" (core func $guest-secure-count))
 (func (export "secure-count") (param "len" u64) (result u32) (canon lift (core func $guest-secure-count) (post-return $reset)))
 (alias core export $guest "insecure-count" (core func $guest-insecure-count))
 (func (export "insecure-count") (param "len" u64) (result u32) (canon lift (core func $guest-insecure-count) (post-return $reset)))
