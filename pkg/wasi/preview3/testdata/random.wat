 (type $insecure-type (instance
  (type (list u8))
  (type (func (param "len" u64) (result 0)))
  (export "get-insecure-random-bytes" (func (type 1)))
  (type (func (result u64)))
  (export "get-insecure-random-u64" (func (type 2)))))
 (import "wasi:random/insecure@0.3.2" (instance $insecure (type $insecure-type)))
 (alias export $insecure "get-insecure-random-bytes" (func $insecure-bytes))
 (alias export $insecure "get-insecure-random-u64" (func $insecure-u64))
 (type $seed-type (instance
  (type (tuple u64 u64))
  (type (func (result 0)))
  (export "get-insecure-seed" (func (type 1)))))
 (import "wasi:random/insecure-seed@0.3.2" (instance $seed (type $seed-type)))
 (alias export $seed "get-insecure-seed" (func $seed))
 (core module $memory
  (memory (export "memory") 2)
  (global $next (mut i32) (i32.const 256))
  (func (export "reset") (param i32) i32.const 256 global.set $next)
  (func (export "realloc") (param i32 i32 i32 i32) (result i32)
   (local $ptr i32)
   global.get $next local.get 2 i32.const 1 i32.sub i32.add
   i32.const 0 local.get 2 i32.sub i32.and local.tee $ptr
   local.get 3 i32.add global.set $next local.get $ptr))
 (core instance $memory (instantiate $memory))
 (alias core export $memory "memory" (core memory $memory-export))
 (alias core export $memory "realloc" (core func $realloc))
 (alias core export $memory "reset" (core func $reset))

 (core func $secure-bytes (canon lower (func $secure-bytes) (memory $memory-export) (realloc $realloc)))
 (core func $secure-u64 (canon lower (func $secure-u64)))
 (core func $insecure-bytes (canon lower (func $insecure-bytes) (memory $memory-export) (realloc $realloc)))
 (core func $insecure-u64 (canon lower (func $insecure-u64)))
 (core func $seed (canon lower (func $seed) (memory $memory-export) (realloc $realloc)))
 (core module $guest
