(module
  (import "env" "memory" (memory 2 4 shared))
  (import "wasi" "thread-spawn" (func $spawn (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (global $tls (mut i32) (i32.const 0))
  (data $initial "INIT")
  (func $init
    (global.set $tls (i32.add (global.get $tls) (i32.const 1)))
    (if (i32.and
          (i32.eq (i32.load (i32.const 0)) (i32.const 9))
          (i32.eq (i32.atomic.load (i32.const 4)) (i32.const 1)))
      (then unreachable))
    (if (i32.eqz (i32.atomic.rmw.cmpxchg (i32.const 4) (i32.const 0) (i32.const 1)))
      (then (memory.init $initial (i32.const 8) (i32.const 0) (i32.const 4)))))
  (start $init)
  (func $wait (param $at i32) (param $value i32)
    (loop $again
      (drop (memory.atomic.wait32 (local.get $at) (local.get $value) (i64.const -1)))
      (br_if $again (i32.eq (i32.atomic.load (local.get $at)) (local.get $value)))))
  (func (export "_start") (local $tid i32) (local $i i32)
    (global.set $tls (i32.const 99))
    (i32.store (i32.const 8) (i32.const 123456))
    (if (i32.eq (i32.load (i32.const 0)) (i32.const 4))
      (then
        (i32.store (i32.const 24) (call $spawn (i32.const 16)))
        (return)))
    (if (i32.eq (i32.load (i32.const 0)) (i32.const 6))
      (then
        (loop $sequential
          (i32.atomic.store (i32.const 16) (i32.const 0))
          (local.set $tid (call $spawn (i32.const 16)))
          (if (i32.le_s (local.get $tid) (local.get $i)) (then unreachable))
          (call $wait (i32.const 16) (i32.const 0))
          (local.set $i (local.get $tid))
          (br_if $sequential (i32.lt_u (local.get $tid) (i32.const 20))))
        (return)))
    (local.set $tid (call $spawn (i32.const 16)))
    (if (i32.le_s (local.get $tid) (i32.const 0)) (then unreachable))
    (i32.store (i32.const 24) (local.get $tid))
    (call $wait (i32.const 16) (i32.const 0))
    (if (i32.ne (i32.load (i32.const 8)) (i32.const 123456)) (then unreachable))
    (if (i32.ne (global.get $tls) (i32.const 99)) (then unreachable)))
  (func (export "wasi_thread_start") (param $tid i32) (param $arg i32)
    (if (i32.ne (global.get $tls) (i32.const 1)) (then unreachable))
    (if (i32.eq (i32.load (i32.const 0)) (i32.const 1)) (then unreachable))
    (if (i32.eq (i32.load (i32.const 0)) (i32.const 2)) (then (call $exit (i32.const 7))))
    (if (i32.eq (i32.load (i32.const 0)) (i32.const 3)) (then (loop $spin (br $spin))))
    (if (i32.eq (i32.load (i32.const 0)) (i32.const 5))
      (then
        (if (i32.eq (local.get $arg) (i32.const 16))
          (then
            (drop (call $spawn (i32.const 32)))
            (call $wait (i32.const 32) (i32.const 0)))
          (else
            (i32.atomic.store (local.get $arg) (i32.const 42))
            (drop (memory.atomic.notify (local.get $arg) (i32.const 1)))
            (return)))))
    (i32.atomic.store (i32.const 20) (local.get $tid))
    (i32.atomic.store (local.get $arg) (i32.const 42))
    (drop (memory.atomic.notify (local.get $arg) (i32.const 1))))
)
