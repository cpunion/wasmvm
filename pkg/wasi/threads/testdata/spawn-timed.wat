(module
 (import "env" "memory" (memory 1 1 shared))
 (import "wasi" "thread-spawn" (func $spawn (param i32) (result i32)))
 (import "wasi_snapshot_preview1" "clock_time_get" (func $clock (param i32 i64 i32) (result i32)))
 (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
 (export "memory" (memory 0))
 (data (i32.const 64) "THRDv001")
 (func (export "wasi_thread_start") (param $tid i32) (param i32)
  (if (i32.or (i32.eqz (local.get $tid)) (i32.ge_u (local.get $tid) (i32.const 536870912))) (then unreachable))
  (i32.atomic.store (i32.const 12) (local.get $tid))
  (drop (i32.atomic.rmw.add (i32.const 4) (i32.const 42)))
  (i32.atomic.store (i32.const 0) (i32.const 1))
  (drop (memory.atomic.notify (i32.const 0) (i32.const 1))))
 (func (export "_start") (local $i i32) (local $tid i32)
  (if (call $clock (i32.const 1) (i64.const 0) (i32.const 32)) (then unreachable))
  (loop $spawnLoop
   (i32.atomic.store (i32.const 0) (i32.const 0))
   (local.set $tid (call $spawn (i32.const 0)))
   (if (i32.le_s (local.get $tid) (i32.const 0)) (then unreachable))
   (loop $wait
    (drop (memory.atomic.wait32 (i32.const 0) (i32.const 0) (i64.const -1)))
    (br_if $wait (i32.eqz (i32.atomic.load (i32.const 0)))))
   (if (i32.ne (i32.atomic.load (i32.const 12)) (local.get $tid)) (then unreachable))
   (local.set $i (i32.add (local.get $i) (i32.const 1)))
   (br_if $spawnLoop (i32.lt_u (local.get $i) (i32.const 128))))
  (if (call $clock (i32.const 1) (i64.const 0) (i32.const 40)) (then unreachable))
  (if (i32.ne (i32.atomic.load (i32.const 4)) (i32.const 5376)) (then unreachable))
  (i64.store (i32.const 72) (i64.sub (i64.load (i32.const 40)) (i64.load (i32.const 32))))
  (i64.store (i32.const 80) (i64.extend_i32_u (i32.atomic.load (i32.const 4))))
  (i64.store (i32.const 88) (i64.const 128))
  (i32.store (i32.const 16) (i32.const 64))
  (i32.store (i32.const 20) (i32.const 32))
  (if (call $write (i32.const 1) (i32.const 16) (i32.const 1) (i32.const 24)) (then unreachable))))
