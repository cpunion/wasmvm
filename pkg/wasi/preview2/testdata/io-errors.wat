(component
 (type $errors (instance
  (export "error" (type $error (sub resource)))
  (type $debug (func (param "self" (borrow $error)) (result string)))
  (export "[method]error.to-debug-string" (func (type $debug)))))
 (import "wasi:io/error@0.2.12" (instance $errors (type $errors)))
 (alias export $errors "error" (type $error))
 (alias export $errors "[method]error.to-debug-string" (func $debug))
 (import "create" (func $create (result (own $error))))
 (core module $memory
  (memory (export "memory") 1)
  (global $next (mut i32) (i32.const 512))
  (func (export "reset") (param i32) i32.const 512 global.set $next)
  (func (export "realloc") (param i32 i32 i32 i32) (result i32)
   (local $ptr i32)
   global.get $next local.get 2 i32.const 1 i32.sub i32.add
   i32.const 0 local.get 2 i32.sub i32.and local.tee $ptr
   local.get 3 i32.add global.set $next local.get $ptr))
 (core instance $memory (instantiate $memory))
 (alias core export $memory "memory" (core memory $mem))
 (alias core export $memory "realloc" (core func $realloc))
 (alias core export $memory "reset" (core func $reset))
 (core func $create (canon lower (func $create)))
 (core func $debug (canon lower (func $debug) (memory $mem) (realloc $realloc)))
 (core func $drop (canon resource.drop $error))
 (core module $guest
  (import "env" "debug" (func $debug (param i32 i32)))
  (import "env" "drop" (func $drop (param i32)))
  (import "env" "memory" (memory 1))
  (func (export "debug") (param i32) (result i32)
   local.get 0 i32.const 0 call $debug local.get 0 call $drop i32.const 0)
  (func (export "debug-count") (param i32) (result i32)
   local.get 0 i32.const 0 call $debug local.get 0 call $drop i32.const 4 i32.load))
 (core instance $env (export "memory" (memory $mem)) (export "debug" (func $debug)) (export "drop" (func $drop)))
 (core instance $guest (instantiate $guest (with "env" (instance $env))))
 (alias core export $guest "debug" (core func $guest-debug))
 (alias core export $guest "debug-count" (core func $guest-debug-count))
 (export "error" (type $error))
 (func (export "create") (result (own $error)) (canon lift (core func $create)))
 (func (export "debug") (param "self" (borrow $error)) (result string)
  (canon lift (core func $guest-debug) (memory $mem) (realloc $realloc) (post-return $reset)))
 (func (export "debug-count") (param "self" (borrow $error)) (result u32)
  (canon lift (core func $guest-debug-count) (memory $mem) (post-return $reset)))
 (func (export "drop") (param "self" (own $error)) (canon lift (core func $drop))))
