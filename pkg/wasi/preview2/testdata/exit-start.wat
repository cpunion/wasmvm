(component
 (type $exit-type (instance
  (type (result))
  (type (func (param "status" 0)))
  (export "exit" (func (type 1)))
  (type (func (param "status-code" u8)))
  (export "exit-with-code" (func (type 2)))))
 (import "wasi:cli/exit@0.2.12" (instance $exit (type $exit-type)))
 (alias export $exit "exit" (func $exit))
 (alias export $exit "exit-with-code" (func $code))
 (core func $exit (canon lower (func $exit)))
 (core func $code (canon lower (func $code)))
 (core module $guest
  (import "env" "exit" (func $exit (param i32)))
  (import "env" "code" (func $code (param i32)))
  (func $start i32.const 42 call $code unreachable)
  (start $start)
  (func (export "success") i32.const 0 call $exit unreachable)
  (func (export "failure") i32.const 1 call $exit unreachable)
  (func (export "with-code") (param i32) local.get 0 call $code unreachable))
 (core instance $env (export "exit" (func $exit)) (export "code" (func $code)))
 (core instance $guest (instantiate $guest (with "env" (instance $env))))
 (alias core export $guest "success" (core func $success))
 (alias core export $guest "failure" (core func $failure))
 (alias core export $guest "with-code" (core func $with-code))
 (func (export "success") (canon lift (core func $success)))
 (func (export "failure") (canon lift (core func $failure)))
 (func (export "with-code") (param "code" u8) (canon lift (core func $with-code)))
 (component $child
  (core module $m (func (export "alive") (result i32) i32.const 7))
  (core instance $m (instantiate $m))
  (alias core export $m "alive" (core func $alive))
  (func (export "alive") (result u32) (canon lift (core func $alive))))
 (instance $left (instantiate $child))
 (instance $right (instantiate $child))
 (export "left" (instance $left))
 (export "right" (instance $right)))
