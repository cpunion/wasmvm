(component
 (type $clock (instance
  (type $definition (record (field "seconds" u64) (field "nanoseconds" u32)))
  (export "datetime" (type $datetime (eq $definition)))
  (type $read (func (result $datetime)))
  (export "now" (func (type $read)))
  (export "resolution" (func (type $read)))))
 (import "wasi:clocks/wall-clock@0.2.12" (instance $clock (type $clock)))
 (alias export $clock "now" (func $now))
 (alias export $clock "resolution" (func $resolution))
 (core module $memory (memory (export "memory") 1))
 (core instance $memory (instantiate $memory))
 (alias core export $memory "memory" (core memory $mem))
 (core func $now (canon lower (func $now) (memory $mem)))
 (core func $resolution (canon lower (func $resolution) (memory $mem)))
 (core module $guest
  (import "env" "memory" (memory 1))
  (import "env" "now" (func $now (param i32)))
  (import "env" "resolution" (func $resolution (param i32)))
  (func (export "now") (result i32) i32.const 0 call $now i32.const 0)
  (func (export "resolution") (result i32) i32.const 16 call $resolution i32.const 16)
  (func (export "now-seconds") (result i64) i32.const 0 call $now i32.const 0 i64.load))
 (core instance $env (export "memory" (memory $mem))
  (export "now" (func $now)) (export "resolution" (func $resolution)))
 (core instance $guest (instantiate $guest (with "env" (instance $env))))
 (alias core export $guest "now" (core func $guest-now))
 (alias core export $guest "resolution" (core func $guest-resolution))
 (alias core export $guest "now-seconds" (core func $guest-now-seconds))
 (type $definition (record (field "seconds" u64) (field "nanoseconds" u32)))
 (export $datetime "datetime" (type $definition))
 (func (export "now") (result $datetime) (canon lift (core func $guest-now) (memory $mem)))
 (func (export "resolution") (result $datetime) (canon lift (core func $guest-resolution) (memory $mem)))
 (func (export "now-seconds") (result u64) (canon lift (core func $guest-now-seconds))))
